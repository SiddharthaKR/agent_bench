{
	"name": "agent-bench",
	"version": "0.0.1",
	"private": true,
	"description": "Light agent harness for local models doing hardware coding (FPGA, DPU, GPU).",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"agent": "tsx src/cli.ts",
		"workflow": "tsx src/cli-workflow.ts",
		"app": "tsx src/server/main.ts",
		"result": "tsx src/cli-result.ts",
		"web:install": "npm --prefix web install",
		"web:build": "npm --prefix web run build",
		"web:dev": "npm --prefix web run dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"typebox": "^1.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
