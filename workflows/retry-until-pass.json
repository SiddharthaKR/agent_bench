{
	"id": "retry-until-pass",
	"name": "Write, check, retry with a fresh start",
	"task": "Describe the block to build, or name the spec file.",
	"vars": {
		"design": "rtl/design.v",
		"tb": "tb/tb_design.v"
	},
	"steps": [
		{
			"id": "write",
			"type": "agent",
			"agent": "fpga",
			"name": "Write or fix the design",
			"task": "{task}"
		},
		{
			"id": "build",
			"type": "command",
			"name": "Build the simulation",
			"command": [
				"iverilog",
				"-g2012",
				"-o",
				".build/sim.out",
				"{design}",
				"{tb}"
			],
			"onFail": {
				"goTo": "write",
				"maxRounds": 3
			}
		},
		{
			"id": "simulate",
			"type": "command",
			"name": "Simulate",
			"command": [
				"vvp",
				".build/sim.out"
			],
			"onFail": {
				"goTo": "write",
				"maxRounds": 3
			}
		}
	]
}
