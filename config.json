{
	"servers": {
		"local": {
			"baseUrl": "http://localhost:11434/v1",
			"model": "gemma4-e4b-ctx32768:latest",
			"temperature": 0.2
		},
		"office": {
			"baseUrl": "http://172.20.1.126:1234/v1",
			"model": "SET-THE-LM-STUDIO-MODEL-ID",
			"temperature": 0.2
		},
		"office-shim": {
			"baseUrl": "http://127.0.0.1:8088/v1",
			"model": "SET-THE-LM-STUDIO-MODEL-ID",
			"temperature": 0.2
		},
		"local-fast": {
			"baseUrl": "http://localhost:11434/v1",
			"model": "gemma4-e4b-ctx32768:latest",
			"temperature": 0.2,
			"extra": {
				"reasoning_effort": "none"
			}
		}
	},
	"commands": {
		"lint": ["verilator", "--lint-only", "-Wall", "{files}"],
		"synth": ["yosys", "-q", "-p", "read_verilog -sv {files}; synth; check -assert"],
		"compile": [
			"iverilog",
			"-g2012",
			"-o",
			"{out}",
			"{files}"
		],
		"simulate": [
			"vvp",
			"{out}"
		]
	}
}
